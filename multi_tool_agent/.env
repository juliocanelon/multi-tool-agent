# Vertex
GOOGLE_CLOUD_PROJECT=heroic-icon-474513-h6
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True

# Repo por defecto (elige SSH si vas a empujar con llave)
# DEFAULT_REPO_URL=git@github.com:juliocanelon/java-app-test-agent.git
DEFAULT_REPO_URL=https://github.com/juliocanelon/java-app-test-agent

# Git – push
GIT_PUSH=true
GIT_REMOTE_NAME=origin
GIT_AUTHOR_NAME=CodeFix Bot
GIT_AUTHOR_EMAIL=bot@local

# Autenticación (elige UNO)
# A) HTTPS con PAT
GIT_AUTH_MODE=HTTPS
GIT_USERNAME=juliocanelon
GIT_TOKEN=

# B) SSH
# GIT_AUTH_MODE=SSH
# GIT_SSH_KEY_PATH=C:\Users\servi\.ssh\id_ed25519
